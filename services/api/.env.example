# --- Google Cloud AI -------------------------------------------------------
# Option A: Gemini API key. Get one free at https://aistudio.google.com/apikey
# The free tier is enough to run this end to end.
GOOGLE_API_KEY=

# Option B: Vertex AI on a Google Cloud project (set USE_VERTEXAI=TRUE)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Both default to flash, which is what the free tier gives useful quota on.
# Set MODEL_REASONING=gemini-2.5-pro only if you have paid quota: it improves
# the scheduling, compliance and budget stages.
MODEL_REASONING=gemini-2.5-flash
MODEL_FAST=gemini-2.5-flash

# Free tiers limit requests per minute, so agents are gated rather than fanned
# out as wide as the work allows. Raise these if you have headroom.
MAX_AGENT_CONCURRENCY=3
AGENT_RETRY_ATTEMPTS=4

# --- Partner track: Parallel ----------------------------------------------
# https://platform.parallel.ai - new accounts start with free credits.
PARALLEL_API_KEY=
PARALLEL_SEARCH_MODE=advanced
PARALLEL_MAX_CONCURRENCY=3
# Every researched entity is a billable search. 12 keeps a full run cheap.
MAX_RESEARCHED_ENTITIES=12

# --- App -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
